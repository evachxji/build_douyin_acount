{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "build_douyin_acount",
  "version": "0.1.0",
  "identifier": "com.builddouyinacount.app",
  "build": {
    "beforeDevCommand": "node scripts/ensure-ytdlp.mjs && node scripts/ensure-ffmpeg.mjs && pnpm --dir frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/ensure-ytdlp.mjs && node scripts/ensure-ffmpeg.mjs && pnpm --dir frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "抖音素材运营助手",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/storage/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/yt-dlp.exe", "resources/ffmpeg.exe", "resources/ffprobe.exe"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
